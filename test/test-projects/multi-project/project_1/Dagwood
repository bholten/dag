project project_1 {
    def TASK_1_BUILD_DIR task_1/build
    def TASK_1_OUT $project_1::TASK_1_BUILD_DIR/task_1.out

    task task_1 {
        outputs $project_1::TASK_1_OUT
        run {
            set -ex
            mkdir -p task_1/build
            touch task_1/build/task_1.out
        }
    }

    def TASK_2_BUILD_DIR task_2/build

    task task_2 {
        inputs $project_1::TASK_1_OUT
        outputs ($project_1::TASK_2_BUILD_DIR/task_2.out1
                 $project_1::TASK_2_BUILD_DIR/task_2.out2
                 $project_1::TASK_2_BUILD_DIR/task_2.out3)
        run {
            set -ex
            mkdir -p task_2/build
            cp task_1/build/task_1.out task_2/build/
            touch task_2/build/task_2.out1
            touch task_2/build/task_2.out2
            touch task_2/build/task_2.out3
        }
    }

    task task_3 {
        inputs $project_1::TASK_2_BUILD_DIR/task_2.out2
        outputs task_3/build/task_3.out
        run {
            set -ex
            mkdir -p task_3/build
            cp task_2/build/task_2.out2 task_3/build/
            touch task_3/build/task_3.out
        }
    }

    command clean {
        run {
            rm -rf task_1 task_2 task_3
        }
    }
}
