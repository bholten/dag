project project_3 {
    let BUILD_DIR build
    let OUTPUT $project_3::BUILD_DIR/combined.txt

    ;; This task depends on outputs from project_1 and project_2
    task combine {
        description "Combine outputs from project_1 and project_2"
        depends_on (project_1::task_1 project_2::build)
        outputs $project_3::OUTPUT
        run {
            mkdir -p $project_3::BUILD_DIR
            echo "Combined from project_1 and project_2" > $project_3::OUTPUT
        }
    }

    command clean {
        run {
            rm -rf $project_3::BUILD_DIR
        }
    }
}
