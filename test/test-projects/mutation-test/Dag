;; Mutation test: import a library and mutate its task graph

import lib/Dag

;; Override: replace mylib::test entirely
task-override mylib::test {
    description "Overridden test"
    depends-on mylib::build
    run { echo "mylib tested (overridden)" }
}

;; Extend: add an extra dependency to mylib::build
task-extend mylib::build {
    always-run true
}

;; Disable: remove mylib::deploy from the graph
task-disable mylib::deploy

;; Override project config
project-override mylib {
    shell /bin/sh
    description "Mutated library"
}

;; Extend: append more deps to mylib::package, which already has
;; depends-on (mylib::build mylib::test). Tests the list-concat path
;; (Issue #37).
task-extend mylib::package {
    depends-on mylib::build
}

;; Define our own project that depends on the mutated import
project mutator {
    task integrate {
        description "Integration task"
        depends-on mylib::test
        run { echo "integration done" }
    }
}
