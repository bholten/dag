;; Dagwood build file for the Dagwood project itself
;; Using the flat LCL DSL syntax

project dagwood {
    config {
        description "The Dagwood task-orchestration tool"
    }

    let SOURCE [Posix::glob src/*.lcl src/*.c src/*.h]

    task fmt {
        description "Run clang-format"
        inputs ${dagwood::SOURCE}
        outputs .clang-format
        run {
            set -ex
            clang-format -i ${dagwood::SOURCE}
            touch .clang-format
        }
    }

    task build {
        inputs ${dagwood::SOURCE}
        outputs build/
        depends-on dagwood::fmt
        run {
            set -ex
            cmake -B build
            cmake --build build
        }
    }

    command clean {
        run {
            rm -rf ${dagwood::build::outputs}
        }
    }
}
