;; Dagwood DSL - LCL Implementation (Nested Design)
;; This file is loaded automatically by the Dagwood C runtime.
;; The C side provides special forms: `project`, `import`

;; Global registry - initialize only once
;; catch returns 1 on error (not initialized), 0 on success (already initialized)
let _dagwood_needs_init [catch { getvar dagwood::projects } _unused]
if {== $_dagwood_needs_init 1} {
    namespace dagwood {
        var projects ()
        var imports #{}
        var primary ()
        var current_project ()
    }
}

proc _split_qualified {qualified_name} {
    let idx [String::find $qualified_name "::"]

    if [< $idx 0] {
        error "Invalid qualified name (missing ::): $qualified_name"
    }

    let proj [String::range $qualified_name 0 $idx]
    let rest [String::range $qualified_name [+ $idx 2] [String::length $qualified_name]]

    return [list $proj $rest]
}

;; ============================================================================
;; Nested Project Implementation
;; ============================================================================

;; The _project proc is called by the C special form with project name and body.
;; It returns a list: (setup_code body) where:
;;   - setup_code should be evaluated at TOP LEVEL to create namespace
;;   - body should be evaluated separately (C handles this)
proc _project {project_name body} {
    ;; Return setup code and body as separate elements
    let setup_code [quasiquote {
        ;; Register project
        set! dagwood::projects [List::push $dagwood::projects ,$project_name]

        ;; Create project namespace with storage and DSL procs
        namespace ,$project_name {
            var _config #{}
            var _tasks #{}
            var _commands #{}

            proc config_impl {body} {
                proc always_run {_always_run} {
                    set! _config [put $_config always_run $_always_run]
                }

                proc description {_description} {
                    set! _config [put $_config description $_description]
                }

                proc shell {_shell} {
                    set! _config [put $_config shell $_shell]
                }

                proc shell_arg {_shell_arg} {
                    set! _config [put $_config shell_arg $_shell_arg]
                }

                eval $body

                return $_config
            }

            proc task_impl {task_name body} {
                var _task #{}

                proc always_run {_always_run} {
                    set! _task [put $_task always_run $_always_run]
                }

                proc depends_on {_depends_on} {
                    set! _task [put $_task depends-on $_depends_on]
                }

                proc description {_description} {
                    set! _task [put $_task description $_description]
                }

                proc inputs {_inputs} {
                    set! _task [put $_task inputs $_inputs]
                }

                proc outputs {_outputs} {
                    set! _task [put $_task outputs $_outputs]
                }

                proc run {_run} {
                    set! _task [put $_task run $_run]
                }

                eval $body

                set! _tasks [put $_tasks $task_name $_task]

                return $_task
            }

            proc command_impl {command_name body} {
                var _command #{}

                proc description {_description} {
                    set! _command [put $_command description $_description]
                }

                proc run {_run} {
                    set! _command [put $_command run $_run]
                }

                eval $body

                set! _commands [put $_commands $command_name $_command]

                return $_command
            }
        }

        ;; Define top-level procs that delegate to namespace-scoped impl procs
        proc config {body} {
            ,${project_name}::config_impl $body
        }

        proc task {name body} {
            ,${project_name}::task_impl $name $body
        }

        proc command {name body} {
            ,${project_name}::command_impl $name $body
        }
    }]

    return [list $setup_code $body]
}

;; ============================================================================
;; Import Implementation
;; ============================================================================

proc _import {path} {
    return [quasiquote {
        let _before_import [len $dagwood::projects]
        load ,$path
        let _after_import [len $dagwood::projects]

        if [> $_after_import $_before_import] {
            let _imported_name [get $dagwood::projects [- $_after_import 1]]
            set! dagwood::imports [put $dagwood::imports $_imported_name ,$path]
        }
    }]
}

proc _import_as {alias path} {
    return [quasiquote {
        let _before_import [len $dagwood::projects]
        load ,$path
        let _after_import [len $dagwood::projects]
        if [> $_after_import $_before_import] {
            let _imported_name [get $dagwood::projects [- $_after_import 1]]
            set! dagwood::imports [put $dagwood::imports ,$alias $_imported_name]
        }
    }]
}

;; ============================================================================
;; Task Manipulation Helpers (for advanced use)
;; ============================================================================

;; Get a task dict from a project
;; Usage: task_get project::taskname
proc task_get {qualified_name} {
    let parts [_split_qualified $qualified_name]
    let proj [get $parts 0]
    let task_name [get $parts 1]
    let tasks_var "${proj}::_tasks"
    let tasks [getvar $tasks_var]

    return [get $tasks $task_name]
}

;; Override a task completely
;; Usage: task_override project::taskname { description "..." run {...} }
proc task_override {qualified_name body} {
    let parts [_split_qualified $qualified_name]
    let proj [get $parts 0]
    let task_name [get $parts 1]

    return [quasiquote {
        ,${proj}::task_impl ,$task_name ,$body
    }]
}

;; Extend/modify an existing task
;; Usage: task_extend project::taskname { depends_on additional_dep }
proc task_extend {qualified_name body} {
    let parts [_split_qualified $qualified_name]
    let proj [get $parts 0]
    let task_name [get $parts 1]

    return [quasiquote {
        let _existing [get $,${proj}::_tasks ,$task_name]
        var _task $_existing

        proc always_run {val} {
            set! _task [put $_task always_run $val]
        }

        proc depends_on {val} {
            let existing [get $_task depends-on]

            if {empty? $existing} {
                set! _task [put $_task depends-on $val]
            } else {
                set! _task [put $_task depends-on [List::push $existing $val]]
            }
        }

        proc description {val} {
            set! _task [put $_task description $val]
        }

        proc inputs {val} {
            let existing [get $_task inputs]

            if {empty? $existing} {
                set! _task [put $_task inputs $val]
            } else {
                set! _task [put $_task inputs [List::push $existing $val]]
            }
        }

        proc outputs {val} {
            let existing [get $_task outputs]
            if {empty? $existing} {
                set! _task [put $_task outputs $val]
            } else {
                set! _task [put $_task outputs [List::push $existing $val]]
            }
        }

        proc run {val} {
            set! _task [put $_task run $val]
        }

        eval ,$body

        set! ,${proj}::_tasks [put $,${proj}::_tasks ,$task_name $_task]
    }]
}

;; Disable/remove a task
proc task_disable {qualified_name} {
    let parts [_split_qualified $qualified_name]
    let proj [get $parts 0]
    let task_name [get $parts 1]

    return [quasiquote {
        set! ,${proj}::_tasks [del $,${proj}::_tasks ,$task_name]
    }]
}
